GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=qwen/qwen3.8-27b
PRIMARY_REASONING_EFFORT=none
CHAT_MODEL=qwen/qwen3.8-27b
CHAT_REASONING_EFFORT=none
LLM_TEMPERATURE=0.2
CHAT_TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=900

# PDF araması ve sıralama bilgisayarda çalışır. İlk kurulum: kurulum.cmd
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_MODEL_DIR=./data/models
LOCAL_DEVICE=cpu
LOCAL_BATCH_SIZE=2
LOCAL_MAX_TOKENS=1024
LOCAL_THREADS=4

# Eski uzak aramayı kullanmak için sağlayıcıları openrouter yapın.
# Farklı sağlayıcıların anahtarları birbirinin yerine kullanılmaz.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=sqlite:///./data/app.db
PDF_DIR=./data/pdfs

TOP_K_RETRIEVE=16
TOP_K_RERANK=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
